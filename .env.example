# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/wish_surprise

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Server Configuration
NODE_ENV=development
PORT=3000
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Wish Surprise

# Storage Configuration (Using Supabase Storage or Local)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# For Supabase Storage (Optional)
# STORAGE_TYPE=supabase
# SUPABASE_URL=your-supabase-url
# SUPABASE_KEY=your-supabase-key
# SUPABASE_BUCKET=wish-surprise-media

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_AUDIO_SIZE=20971520
MAX_PHOTOS=15

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
PASSWORD_ATTEMPT_LIMIT=5
PASSWORD_ATTEMPT_WINDOW_MS=900000

# Security
BCRYPT_ROUNDS=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Expiry Cleanup Job
CLEANUP_INTERVAL_MS=3600000
